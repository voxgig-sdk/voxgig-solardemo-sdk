
main: kit: target: ts: {
  
  title: TypeScript
  ext: ts
  comment: line: "//"
  module: name: 'solardemo'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'

  deps: &: {
    # TODO: fix aontu disjunctions!
    kind: *'prod' | string # 'peer' |'dev'
  }
  
  deps: {
    'pino': { active: true, version: '^10.3.1', kind: prod }
    'pino-pretty': { active: true, version: '^13.1.3', kind: prod }
    'dotenv': { active: true, version: '^17.4.2', kind: dev }
    'typescript': { active: true, version: '^6.0.3', kind: dev }
    '@types/node': { active: true, version: '^25.9.2', kind: dev }
  }
}


main: kit: feature: &: target: ts: deps: &: {
  # TODO: fix aontu disjunctions!
  kind: *'prod' | string # 'peer' |'dev'
}
