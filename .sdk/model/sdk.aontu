
# Model definitions.
@"@voxgig/apidef/model/apidef.aontu"
@"@voxgig/sdkgen/model/sdkgen.aontu"


# SDK Details.
# The slug drives EVERY derived identity: the npm package
# (@<origin>/<name>), the Go module and repo path
# (github.com/<origin>/<name>-sdk/go), and the SDK class names. It is
# 'voxgig-solardemo', not 'solardemo', so that all three match this repo —
# voxgig-sdk/voxgig-solardemo-sdk — with no generator overrides.
name: 'voxgig-solardemo'
origin: 'voxgig-sdk'
def: 'solardemo-1.0.0-openapi-3.0.0.yaml'


# API Information
@"api/api-info.aontu"


# SDK Configuration.
@"config.aontu"


# SDK Entities
@"entity/entity-index.aontu"


# SDK Features.
@"feature/feature-index.aontu"
 

# SDK Targets.
@"target/target-index.aontu"


# Operation workflows.
@"flow/flow-index.aontu"

