opam-version: "2.0"
name: "voxgig-voxgig-solardemo-sdk"
version: "0.0.1"
synopsis: "Unofficial generated OCaml SDK for the Solar System public API. Not affiliated with or endorsed by the upstream API provider."
maintainer: "Voxgig"
authors: "Voxgig"
license: "MIT"
homepage: "https://github.com/voxgig-sdk/voxgig-solardemo-sdk"
bug-reports: "https://github.com/voxgig-sdk/voxgig-solardemo-sdk/issues"
# The generated SDK is dependency-free: it compiles with the stock ocamlc
# (see the Makefile). No opam packages, no dune.
depends: [
  "ocaml" {>= "4.14"}
]
build: [
  [make "build"]
]
